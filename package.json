{
  "name": "jibinjohnson-in",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website of Jibin Johnson. Plain HTML/CSS/JS in site/, dev-only Node tools in tools/.",
  "type": "module",
  "scripts": {
    "sync": "node tools/sync-partials.mjs",
    "bust": "node tools/cache-bust.mjs",
    "images": "node tools/optimize-images.mjs",
    "og": "node tools/make-og.mjs",
    "icons": "node tools/make-icons.mjs",
    "sitemap": "node tools/generate-sitemap.mjs",
    "check": "node tools/check-seo.mjs",
    "prepare-deploy": "npm run bust && npm run sync && npm run sitemap && npm run check",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  }
}
